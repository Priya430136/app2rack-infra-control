FROM node:22-alpine

RUN apk add --no-cache chromium ca-certificates ttf-freefont font-noto util-linux

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV CHROME_EXECUTABLE_PATH=/usr/bin/chromium-browser

WORKDIR /work

COPY package.json ./
RUN npm install

COPY . .

CMD ["node", "scripts/render-remotion.mjs"]
