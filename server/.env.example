PORT=5000
NODE_ENV=development

# Database Configuration
# Default here matches docker-compose.yml (postgres service published on host port 5433).
# If pointing at a different PostgreSQL instance, update all five values accordingly.
DB_HOST=localhost
DB_PORT=5433
DB_USER=app2rack
DB_PASSWORD=change_me
DB_NAME=app2rack

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_random_64_char_hex_string
JWT_EXPIRES_IN=24h

# CORS - must match the origin the frontend dev server runs on.
# The TanStack Start dev server in this repo is hard-pinned to port 8080.
CLIENT_URL=http://localhost:8080

# AI Provider (optional). Leave both keys blank to run entirely on the
# built-in rule-based analysis engines - the Log Analyzer and Optimization
# Advisor work fully without this section. Set AI_PROVIDER to "openai" or
# "anthropic" and fill in the matching key below to enable real AI analysis.
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-oss-120b
# For Groq, use https://api.groq.com/openai/v1.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
